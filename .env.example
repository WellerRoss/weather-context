# Copy this file to .env and fill in your values (optional — everything has a
# sensible default and no API key is required for Open-Meteo). .env is gitignored.

# Where the local SQLite cache of weather lookups lives. Keep this OUTSIDE any git
# repository. Deliberately not nested under any other ecosystem repo's DATA_DIR —
# this repo makes no assumptions about what it's being used for.
DATA_DIR=~/data/weather-context
